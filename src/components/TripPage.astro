---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Nav from "./Nav.astro";
import Footer from "./Footer.astro";
import { tripAlternates, tripUrl, type Photo, type Trip } from "../data/trips";
import { routes, useT } from "../i18n/ui";

interface Props {
  trip: Trip;
  next: Trip;
}

const { trip, next } = Astro.props;
const locale = trip.locale;
const t = useT(locale);
const alternates = tripAlternates(trip.id);

const featured = trip.fauna.filter((s) => s.photo);
const others = trip.fauna.filter((s) => !s.photo);

const photos: Photo[] = [
  trip.hero,
  ...trip.stages.map((s) => s.photo),
  ...featured.map((s) => s.photo!),
];
const credits = [...new Map(photos.map((p) => [p.credit.page, p.credit])).values()];

const mail = `mailto:hello@example.com?subject=${encodeURIComponent(
  `${trip.country} — ${trip.title}`
)}`;
---

<Layout
  title={`${trip.country} — ${trip.title} · Tramuntana`}
  description={trip.summary}
  locale={locale}
  alternates={alternates}
>
  <Nav locale={locale} alternates={alternates} />
  <main>
    <section class="trip-hero" aria-label={trip.title}>
      <div class="trip-hero-media">
        <Image
          src={trip.hero.src}
          alt={trip.hero.alt}
          widths={[960, 1600, 2400]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
        />
        <div class="trip-hero-scrim"></div>
      </div>

      <div class="trip-hero-content section-pad">
        <a class="trip-back label" href={`${routes.home(locale)}#expeditions`}>
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M13 7H2M6.5 2.5 2 7l4.5 4.5" stroke="currentColor" stroke-width="1.5" />
          </svg>
          {t("trip.back")}
        </a>
        <p class="trip-kicker label">{trip.country} · {trip.route}</p>
        <h1 class="trip-title serif">{trip.title}</h1>
        <dl class="trip-facts">
          <div>
            <dt class="label">{t("trip.duration")}</dt>
            <dd>{trip.duration}</dd>
          </div>
          <div>
            <dt class="label">{t("trip.bestSeason")}</dt>
            <dd>{trip.seasonShort}</dd>
          </div>
          <div>
            <dt class="label">{t("trip.stages")}</dt>
            <dd>{trip.stages.length}</dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="trip-intro section-pad" aria-label={t("trip.about")}>
      <div class="trip-intro-text">
        <p class="label trip-section-kicker reveal">{t("trip.journey")}</p>
        {
          trip.intro.map((para, i) => (
            <p class:list={["reveal", i === 0 ? "trip-lead serif" : "trip-body"]}>{para}</p>
          ))
        }
      </div>

      <aside class="glance reveal" aria-label={t("trip.glance")}>
        <p class="label glance-head">{t("trip.glance")}</p>
        <dl>
          <div class="glance-row">
            <dt class="label">{t("trip.duration")}</dt>
            <dd>{trip.duration}</dd>
          </div>
          <div class="glance-row">
            <dt class="label">{t("trip.bestSeason")}</dt>
            <dd>{trip.season}</dd>
          </div>
          <div class="glance-row">
            <dt class="label">{t("trip.route")}</dt>
            <dd>
              <ol class="glance-route">
                {
                  trip.stages.map((s) => (
                    <li>
                      <span class="glance-days">{s.days}</span>
                      {s.place}
                    </li>
                  ))
                }
              </ol>
            </dd>
          </div>
          {
            trip.facts && (
              <div class="glance-row">
                <dt class="label">{t("trip.goodToKnow")}</dt>
                <dd>{trip.facts.join(" · ")}</dd>
              </div>
            )
          }
        </dl>
        <ul class="glance-tags" aria-label={t("trip.focus")}>
          {trip.tags.map((tag) => <li class="label">{tag}</li>)}
        </ul>
      </aside>
    </section>

    <section class="itinerary" aria-label={t("trip.itinerary")}>
      <header class="itinerary-head section-pad">
        <p class="label trip-section-kicker reveal">{t("trip.itinerary")}</p>
        <h2 class="itinerary-title serif reveal" set:html={t("trip.dayByDay")} />
      </header>

      {
        trip.stages.map((stage, i) => (
          <article class:list={["stage section-pad", { flip: i % 2 === 1 }]}>
            <div class="stage-media">
              <div class="stage-frame">
                <div class="stage-parallax" data-parallax>
                  <Image
                    src={stage.photo.src}
                    alt={stage.photo.alt}
                    widths={[640, 1024, 1600]}
                    sizes="(max-width: 860px) 100vw, 50vw"
                  />
                </div>
                <span class="stage-num serif" aria-hidden="true">
                  {String(i + 1).padStart(2, "0")}
                </span>
              </div>
            </div>

            <div class="stage-body">
              <p class="stage-meta label reveal">
                <span class="stage-days">{stage.days}</span>
                <span>{stage.place}</span>
              </p>
              <h3 class="stage-title serif reveal">{stage.title}</h3>
              {stage.intro && <p class="stage-intro reveal">{stage.intro}</p>}
              {stage.items && (
                <ul class="stage-list reveal">
                  {stage.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              )}
              {stage.schedule && (
                <ol class="schedule">
                  {stage.schedule.map((day) => (
                    <li class="schedule-day reveal">
                      <p class="schedule-label label">{day.label}</p>
                      <div>
                        {day.title && <p class="schedule-title serif">{day.title}</p>}
                        <ul class="stage-list">
                          {day.items.map((item) => (
                            <li>{item}</li>
                          ))}
                        </ul>
                      </div>
                    </li>
                  ))}
                </ol>
              )}
            </div>
          </article>
        ))
      }
    </section>

    <section class="fauna section-pad" aria-label={t("trip.wildlife")}>
      <header class="fauna-head">
        <p class="label trip-section-kicker reveal">{t("trip.wildlife")}</p>
        <h2 class="fauna-title serif reveal" set:html={t("trip.species")} />
      </header>

      <div class="fauna-grid">
        {
          featured.map((s) => (
            <figure class="species reveal">
              <div class="species-media">
                <Image
                  src={s.photo!.src}
                  alt={s.photo!.alt}
                  widths={[480, 800]}
                  sizes="(max-width: 760px) 50vw, 25vw"
                />
              </div>
              <figcaption>
                <span class="species-name serif">{s.name}</span>
                {s.note && <span class="species-note">{s.note}</span>}
              </figcaption>
            </figure>
          ))
        }
      </div>

      {
        others.length > 0 && (
          <ul class="fauna-list">
            {others.map((s) => (
              <li class="reveal">
                <span class="serif">{s.name}</span>
                {s.note && <span class="species-note">{s.note}</span>}
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <section class="season section-pad" aria-label={t("trip.bestTime")}>
      <p class="label trip-section-kicker reveal">{t("trip.bestTime")}</p>
      <p class="season-name serif reveal">{trip.season}</p>
      <ul class="season-why">
        {trip.seasonWhy.map((why) => <li class="reveal">{why}</li>)}
      </ul>
    </section>

    <section class="enquire section-pad" aria-label={t("trip.enquireAria")}>
      <h2
        class="enquire-title serif reveal"
        set:html={t("trip.enquire", { country: trip.country })}
      />
      <p class="enquire-text reveal">{t("trip.enquireText")}</p>
      <a class="enquire-cta label reveal" href={mail} data-magnetic>
        {t("trip.enquireCta")}
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M4 16 16 4M7 4h9v9" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </a>
    </section>

    <a
      class="next"
      href={tripUrl(next)}
      aria-label={`${t("trip.next")}: ${next.country} — ${next.title}`}
    >
      <div class="next-parallax" data-parallax>
        <Image src={next.hero.src} alt="" widths={[960, 1600, 2400]} sizes="100vw" />
      </div>
      <div class="next-scrim"></div>
      <div class="next-content section-pad">
        <p class="label">{t("trip.next")} · {next.country}</p>
        <p class="next-title serif">
          {next.title}
          <svg width="28" height="28" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M4 16 16 4M7 4h9v9" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </p>
      </div>
    </a>

    <section class="credits section-pad" aria-label={t("trip.credits")}>
      <details>
        <summary class="label">{t("trip.credits")}</summary>
        <ul>
          {
            credits.map((c) => (
              <li>
                <a href={c.page} rel="noopener" target="_blank">{c.title}</a>
                {c.artist && <> {t("trip.creditBy")} {c.artist}</>}, {c.license}, {t("trip.via")}
              </li>
            ))
          }
        </ul>
      </details>
    </section>
  </main>
  <Footer locale={locale} />
</Layout>

<script>
  import "../scripts/animations";
</script>

<style>
  /* ------------------------------------------------------------------ hero */
  .trip-hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    color: var(--cream);
    overflow: hidden;
  }

  .trip-hero-media {
    position: absolute;
    inset: 0;
  }

  .trip-hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: kenburns 16s ease-out forwards;
  }

  @keyframes kenburns {
    from {
      transform: scale(1.06);
    }
    to {
      transform: scale(1);
    }
  }

  .trip-hero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(22, 20, 18, 0.45), transparent 30%),
      linear-gradient(to top, rgba(22, 20, 18, 0.78), transparent 65%);
  }

  .trip-hero-content {
    position: relative;
    width: 100%;
    padding-block: 7rem clamp(2rem, 6vh, 4rem);
  }

  .trip-back {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: clamp(2rem, 8vh, 5rem);
    opacity: 0.85;
    transition: opacity 0.3s var(--ease-out);
  }

  .trip-back:hover {
    opacity: 1;
  }

  .trip-back svg {
    transition: transform 0.35s var(--ease-out);
  }

  .trip-back:hover svg {
    transform: translateX(-4px);
  }

  .trip-kicker {
    margin-bottom: 1.1rem;
    opacity: 0.9;
  }

  .trip-title {
    font-size: clamp(2.8rem, 8vw, 7.5rem);
    line-height: 0.95;
    max-width: 14ch;
    text-wrap: balance;
    font-weight: 340;
  }

  .trip-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem clamp(2rem, 5vw, 4.5rem);
    margin-top: clamp(2rem, 5vh, 3.25rem);
    padding-top: 1.4rem;
    border-top: 1px solid rgba(240, 239, 233, 0.3);
  }

  .trip-facts dt {
    opacity: 0.7;
    margin-bottom: 0.25rem;
  }

  .trip-facts dd {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2vw, 1.6rem);
  }

  .trip-section-kicker {
    color: var(--terracotta);
    margin-bottom: 1.4rem;
  }

  /* ----------------------------------------------------------------- intro */
  .trip-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: clamp(3rem, 7vw, 7rem);
    padding-block: clamp(5rem, 12vh, 9rem);
    align-items: start;
  }

  .trip-lead {
    font-size: clamp(1.5rem, 2.8vw, 2.4rem);
    line-height: 1.22;
    max-width: 30ch;
  }

  .trip-body {
    margin-top: 1.6rem;
    max-width: 52ch;
    color: var(--ink-soft);
    font-size: 1.0625rem;
  }

  .glance {
    border-top: 1px solid var(--ink);
    padding-top: 1.2rem;
  }

  .glance-head {
    margin-bottom: 1rem;
  }

  .glance-row {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 1rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--line);
  }

  .glance-row dt {
    color: var(--ink-soft);
    padding-top: 0.2rem;
  }

  .glance-route {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }

  .glance-days {
    display: block;
    font-size: 0.75rem;
    color: var(--ink-soft);
  }

  .glance-tags {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1.4rem;
  }

  .glance-tags li {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.35rem 0.7rem;
    font-size: 0.625rem;
  }

  /* ------------------------------------------------------------- itinerary */
  .itinerary {
    padding-bottom: clamp(3rem, 8vh, 6rem);
  }

  .itinerary-head {
    padding-bottom: clamp(2.5rem, 6vh, 4.5rem);
  }

  .itinerary-title,
  .fauna-title {
    font-size: clamp(2.6rem, 6vw, 5rem);
    line-height: 0.98;
  }

  .itinerary-title em,
  .fauna-title em,
  .enquire-title em {
    font-style: italic;
    font-weight: 320;
    color: var(--terracotta);
  }

  .stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
    padding-block: clamp(2.5rem, 7vh, 5rem);
    border-top: 1px solid var(--line);
    align-items: start;
  }

  .stage.flip .stage-media {
    order: 2;
  }

  .stage-media {
    position: sticky;
    top: 5rem;
  }

  .stage-frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    max-height: calc(100svh - 7rem);
    width: 100%;
    background: var(--cream-deep);
  }

  .stage-parallax {
    position: absolute;
    inset: -10% 0;
  }

  .stage-parallax img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .stage-num {
    position: absolute;
    left: 1.1rem;
    bottom: 0.6rem;
    font-size: clamp(3rem, 6vw, 5rem);
    color: var(--cream);
    text-shadow: 0 2px 24px rgba(22, 20, 18, 0.45);
    font-weight: 320;
  }

  .stage-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    color: var(--ink-soft);
    margin-bottom: 0.9rem;
  }

  .stage-days {
    color: var(--terracotta);
  }

  .stage-title {
    font-size: clamp(1.9rem, 3.6vw, 3rem);
    line-height: 1.04;
    margin-bottom: 1.4rem;
    max-width: 18ch;
  }

  .stage-intro {
    font-size: 1.0625rem;
    color: var(--ink-soft);
    max-width: 52ch;
    margin-bottom: 1.4rem;
  }

  .stage-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.55rem;
    max-width: 52ch;
  }

  .stage-list li {
    position: relative;
    padding-left: 1.3rem;
  }

  .stage-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 0.55rem;
    height: 1px;
    background: var(--terracotta);
  }

  .schedule {
    list-style: none;
    padding: 0;
  }

  .schedule-day {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 1rem;
    padding-block: 1.3rem;
    border-top: 1px solid var(--line);
  }

  .schedule-day:first-child {
    border-top: none;
    padding-top: 0.4rem;
  }

  .schedule-label {
    color: var(--terracotta);
    padding-top: 0.35rem;
  }

  .schedule-title {
    font-size: 1.35rem;
    margin-bottom: 0.6rem;
  }

  /* ----------------------------------------------------------------- fauna */
  .fauna {
    background: var(--cream-deep);
    padding-block: clamp(5rem, 12vh, 8rem);
  }

  .fauna-head {
    margin-bottom: clamp(2.5rem, 6vh, 4rem);
  }

  .fauna-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.75rem);
  }

  .species-media {
    overflow: hidden;
    aspect-ratio: 3 / 4;
    background: var(--cream);
  }

  .species-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease-out);
  }

  .species:hover .species-media img {
    transform: scale(1.05);
  }

  .species figcaption {
    padding-top: 0.8rem;
    display: grid;
    gap: 0.15rem;
  }

  .species-name {
    font-size: 1.35rem;
  }

  .species-note {
    font-size: 0.875rem;
    color: var(--ink-soft);
  }

  .fauna-list {
    list-style: none;
    padding: 0;
    margin-top: clamp(3rem, 7vh, 4.5rem);
    columns: 2;
    column-gap: clamp(2rem, 6vw, 6rem);
  }

  .fauna-list li {
    break-inside: avoid;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.9rem;
    padding-block: 0.85rem;
    border-top: 1px solid var(--line);
  }

  .fauna-list .serif {
    font-size: 1.25rem;
  }

  /* ---------------------------------------------------------------- season */
  .season {
    padding-block: clamp(5rem, 12vh, 9rem);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .season-name {
    font-size: clamp(2.2rem, 5.5vw, 4.6rem);
    max-width: 18ch;
    text-wrap: balance;
    font-style: italic;
    font-weight: 320;
  }

  .season-why {
    list-style: none;
    padding: 0;
    margin-top: 2rem;
    display: grid;
    gap: 0.4rem;
    color: var(--ink-soft);
    font-size: 1.0625rem;
  }

  /* --------------------------------------------------------------- enquire */
  .enquire {
    border-top: 1px solid var(--line);
    padding-block: clamp(4.5rem, 10vh, 7rem);
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 1.5rem clamp(2rem, 6vw, 6rem);
    align-items: end;
  }

  .enquire-title {
    font-size: clamp(2.2rem, 5vw, 4.2rem);
    line-height: 1;
    grid-row: span 2;
  }

  .enquire-text {
    color: var(--ink-soft);
    max-width: 34ch;
  }

  .enquire-cta {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 1rem 1.5rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--cream);
    transition: background-color 0.35s var(--ease-out);
  }

  .enquire-cta:hover {
    background: var(--terracotta);
  }

  /* ------------------------------------------------------------------ next */
  .next {
    position: relative;
    display: flex;
    align-items: flex-end;
    height: clamp(22rem, 70vh, 40rem);
    overflow: hidden;
    color: var(--cream);
  }

  .next-parallax {
    position: absolute;
    inset: -12% 0;
  }

  .next-parallax img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s var(--ease-out);
  }

  .next:hover .next-parallax img {
    transform: scale(1.04);
  }

  .next-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(22, 20, 18, 0.72), rgba(22, 20, 18, 0.1) 70%);
  }

  .next-content {
    position: relative;
    padding-block: clamp(2rem, 6vh, 3.5rem);
  }

  .next-content .label {
    opacity: 0.85;
    margin-bottom: 0.8rem;
  }

  .next-title {
    font-size: clamp(2.2rem, 6vw, 5.5rem);
    line-height: 0.98;
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
  }

  .next-title svg {
    flex: none;
    transition: transform 0.4s var(--ease-out);
  }

  .next:hover .next-title svg {
    transform: translate(4px, -4px);
  }

  /* --------------------------------------------------------------- credits */
  .credits {
    padding-block: 1.6rem;
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }

  .credits summary {
    cursor: pointer;
    width: fit-content;
  }

  .credits ul {
    list-style: none;
    padding: 0;
    margin-top: 1rem;
    display: grid;
    gap: 0.3rem;
  }

  .credits a {
    text-decoration: underline;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }

  /* ---------------------------------------------------------------- mobile */
  @media (max-width: 860px) {
    .trip-intro,
    .enquire {
      grid-template-columns: 1fr;
    }

    .enquire-title {
      grid-row: auto;
    }

    .stage {
      grid-template-columns: 1fr;
    }

    .stage.flip .stage-media {
      order: 0;
    }

    .stage-media {
      position: static;
    }

    .stage-frame {
      aspect-ratio: 4 / 3;
    }

    .fauna-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .fauna-list {
      columns: 1;
    }
  }

  @media (max-width: 480px) {
    .glance-row {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }

    .schedule-day {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .trip-hero-media img {
      animation: none;
    }
  }
</style>
