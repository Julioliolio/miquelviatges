---
// The "breath" between hero and packages: one editorial line, revealed word by word.
import { useT, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const t = useT(Astro.props.locale);
---

<section class="statement section-pad" aria-label={t("statement.aria")}>
  <p class="statement-kicker label reveal">{t("statement.kicker")}</p>
  <p class="statement-line serif" data-split-words>{t("statement.line")}</p>
</section>

<style>
  .statement {
    padding-block: clamp(6rem, 14vh, 10rem);
    max-width: 68rem;
  }

  .statement-kicker {
    color: var(--terracotta);
    margin-bottom: 1.6rem;
  }

  .statement-line {
    font-size: clamp(1.75rem, 3.6vw, 3.1rem);
    line-height: 1.22;
    letter-spacing: -0.005em;
    max-width: 26ch;
  }

  /* Word spans injected by animations.ts */
  .statement-line :global(.w) {
    display: inline-block;
  }
</style>
