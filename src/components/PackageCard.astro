---
import { Image } from "astro:assets";
import { tripUrl, type Trip } from "../data/trips";

interface Props {
  trip: Trip;
}

const { trip } = Astro.props;
---

<article class="card reveal">
  <a href={tripUrl(trip.slug)} class="card-link" aria-label={`${trip.country} — ${trip.title}`}>
    <div class="card-media">
      <div class="card-parallax" data-parallax>
        <Image
          src={trip.hero.src}
          alt={trip.hero.alt}
          widths={[640, 960, 1400]}
          sizes="(max-width: 760px) 100vw, 50vw"
        />
      </div>
      <span class="card-tag label">{trip.duration}</span>
    </div>
    <div class="card-body">
      <div class="card-meta label">
        <span class="card-country">{trip.country}</span>
        <span class="card-dates">Best · {trip.seasonShort}</span>
      </div>
      <h3 class="card-title serif">
        {trip.title}
        <svg
          class="card-arrow"
          width="20"
          height="20"
          viewBox="0 0 20 20"
          fill="none"
          aria-hidden="true"
        >
          <path d="M4 16 16 4M7 4h9v9" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </h3>
      <p class="card-route">{trip.route}</p>
      <p class="card-summary">{trip.summary}</p>
    </div>
  </a>
</article>

<style>
  .card-link {
    display: block;
  }

  .card-media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--cream-deep);
  }

  /* Parallax wrapper is oversized; GSAP drives its Y position on scroll. */
  .card-parallax {
    position: absolute;
    inset: -12% 0;
  }

  .card-parallax img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease-out);
  }

  .card-link:hover .card-parallax img {
    transform: scale(1.05);
  }

  .card-tag {
    position: absolute;
    top: 1rem;
    left: 1rem;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    background: var(--cream);
    color: var(--ink);
  }

  .card-body {
    padding-top: 1.1rem;
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--ink-soft);
    margin-bottom: 0.5rem;
  }

  .card-country {
    color: var(--terracotta);
  }

  .card-title {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    line-height: 1.1;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .card-arrow {
    flex: none;
    opacity: 0;
    transform: translate(-6px, 6px);
    transition:
      opacity 0.35s var(--ease-out),
      transform 0.35s var(--ease-out);
  }

  .card-link:hover .card-arrow {
    opacity: 1;
    transform: translate(0, 0);
  }

  .card-route {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .card-summary {
    margin-top: 0.35rem;
    font-size: 0.9375rem;
    color: var(--ink-soft);
    max-width: 46ch;
  }
</style>
