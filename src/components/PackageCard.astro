---
import type { TravelPackage } from "../data/packages";

interface Props {
  pkg: TravelPackage;
}

const { pkg } = Astro.props;
const soldOut = pkg.availability === "soldout";
---

<article class:list={["card", "reveal", { soldout: soldOut }]}>
  <a href="#" class="card-link" aria-label={`${pkg.country} — ${pkg.title}`}>
    <div class="card-media">
      <div class="card-parallax" data-parallax>
        <img src={pkg.image} alt={pkg.alt} loading="lazy" />
      </div>
      <span class:list={["card-tag", "label", pkg.availability]}>
        {pkg.availabilityLabel}
      </span>
    </div>
    <div class="card-body">
      <div class="card-meta label">
        <span class="card-country">{pkg.country}</span>
        <span class="card-dates">{pkg.dates}</span>
      </div>
      <h3 class="card-title serif">
        {pkg.title}
        <svg
          class="card-arrow"
          width="20"
          height="20"
          viewBox="0 0 20 20"
          fill="none"
          aria-hidden="true"
        >
          <path d="M4 16 16 4M7 4h9v9" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </h3>
      <p class="card-price">from <strong>{pkg.price}</strong> per person</p>
    </div>
  </a>
</article>

<style>
  .card-link {
    display: block;
  }

  .card-media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--cream-deep);
  }

  /* Parallax wrapper is oversized; GSAP drives its Y position on scroll. */
  .card-parallax {
    position: absolute;
    inset: -12% 0;
  }

  .card-parallax img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease-out);
  }

  .card-link:hover .card-parallax img {
    transform: scale(1.05);
  }

  .card-tag {
    position: absolute;
    top: 1rem;
    left: 1rem;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    background: var(--cream);
    color: var(--ink);
  }

  .card-tag.few {
    background: var(--terracotta);
    color: var(--cream);
  }

  .card-tag.soldout {
    background: var(--ink);
    color: var(--cream);
  }

  .soldout .card-media {
    filter: saturate(0.35);
  }

  .card-body {
    padding-top: 1.1rem;
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--ink-soft);
    margin-bottom: 0.5rem;
  }

  .card-country {
    color: var(--terracotta);
  }

  .card-title {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    line-height: 1.1;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .card-arrow {
    flex: none;
    opacity: 0;
    transform: translate(-6px, 6px);
    transition:
      opacity 0.35s var(--ease-out),
      transform 0.35s var(--ease-out);
  }

  .card-link:hover .card-arrow {
    opacity: 1;
    transform: translate(0, 0);
  }

  .card-price {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }

  .card-price strong {
    color: var(--ink);
    font-weight: 600;
  }
</style>
