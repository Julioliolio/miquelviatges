---
// Sticky nav: transparent over the hero, cream + hairline once scrolled.
import { locales, routes, useT, localeNames, type Alternates, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
  alternates: Alternates;
}

const { locale, alternates } = Astro.props;
const t = useT(locale);
const home = routes.home(locale);
---

<header class="nav" id="site-nav">
  <nav class="nav-inner section-pad">
    <a href={`${home}#expeditions`} class="label nav-link">{t("nav.expeditions")}</a>
    <a href={home} class="wordmark serif" aria-label={t("nav.home")} data-nav-wordmark>Tramuntana</a>
    <div class="nav-right">
      <a href={`${home}#philosophy`} class="label nav-link">{t("nav.project")}</a>
      <ul class="lang label" aria-label={t("nav.language")}>
        {
          locales.map((l) => (
            <li>
              <a
                href={alternates[l]}
                hreflang={l}
                lang={l}
                data-lang={l}
                title={localeNames[l]}
                aria-current={l === locale ? "true" : undefined}
              >
                {l.toUpperCase()}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    color: var(--cream);
    transition:
      background-color 0.4s var(--ease-out),
      color 0.4s var(--ease-out),
      box-shadow 0.4s var(--ease-out);
  }

  .nav.scrolled {
    background: color-mix(in srgb, var(--cream) 92%, transparent);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: var(--ink);
    box-shadow: inset 0 -1px 0 var(--line);
  }

  .nav-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 3.75rem;
  }

  .wordmark {
    grid-column: 2;
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .nav-right {
    grid-column: 3;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-link {
    grid-column: 1;
    position: relative;
    justify-self: start;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -3px;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.35s var(--ease-out);
  }

  .nav-link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .lang {
    list-style: none;
    padding: 0.15rem;
    display: flex;
    border: 1px solid currentColor;
    border-radius: 999px;
  }

  .lang a {
    display: block;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    opacity: 0.7;
    transition:
      opacity 0.3s var(--ease-out),
      background-color 0.3s var(--ease-out),
      color 0.3s var(--ease-out);
  }

  .lang a:hover {
    opacity: 1;
  }

  .lang a[aria-current] {
    opacity: 1;
    background: var(--cream);
    color: var(--ink);
  }

  .nav.scrolled .lang a[aria-current] {
    background: var(--ink);
    color: var(--cream);
  }

  @media (max-width: 640px) {
    .nav-link {
      display: none;
    }
    .lang {
      font-size: 0.625rem;
    }
    .wordmark {
      font-size: 1.15rem;
    }
  }
</style>
