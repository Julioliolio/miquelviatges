---
import Layout from "../layouts/Layout.astro";
import Nav from "./Nav.astro";
import Hero from "./Hero.astro";
import Statement from "./Statement.astro";
import PackageGrid from "./PackageGrid.astro";
import DestinationIndex from "./DestinationIndex.astro";
import Philosophy from "./Philosophy.astro";
import ExpandingGallery from "./ExpandingGallery.astro";
import Footer from "./Footer.astro";
import { locales, routes, useT, type Alternates, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useT(locale);
const alternates = Object.fromEntries(locales.map((l) => [l, routes.home(l)])) as Alternates;
---

<Layout
  title={t("meta.homeTitle")}
  description={t("meta.homeDescription")}
  locale={locale}
  alternates={alternates}
>
  <Nav locale={locale} alternates={alternates} />
  <main>
    <Hero locale={locale} />
    <Statement locale={locale} />
    <PackageGrid locale={locale} />
    <DestinationIndex locale={locale} />
    <Philosophy locale={locale} />
    <ExpandingGallery locale={locale} />
  </main>
  <Footer locale={locale} />
</Layout>

<script>
  import "../scripts/animations";
</script>
