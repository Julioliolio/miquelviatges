---
// Mission band with a full-width parallax photo divider.
import { useT, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const t = useT(Astro.props.locale);
const dividerImage =
  "https://images.unsplash.com/photo-1488646953014-85cb44e25828?auto=format&fit=crop&w=2000&q=80";
---

<section class="philosophy" id="philosophy" aria-label={t("philosophy.kicker")}>
  <div class="philosophy-divider">
    <div class="philosophy-parallax" data-parallax>
      <img src={dividerImage} alt={t("philosophy.alt")} loading="lazy" />
    </div>
  </div>

  <div class="philosophy-body section-pad">
    <p class="label philosophy-kicker reveal">{t("philosophy.kicker")}</p>
    <p class="philosophy-text serif reveal">{t("philosophy.text")}</p>
    <a class="philosophy-link label reveal" href="#" data-magnetic>
      {t("philosophy.link")}
      <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M4 16 16 4M7 4h9v9" stroke="currentColor" stroke-width="1.5" />
      </svg>
    </a>
  </div>
</section>

<style>
  .philosophy-divider {
    position: relative;
    overflow: hidden;
    height: clamp(16rem, 55vh, 30rem);
  }

  .philosophy-parallax {
    position: absolute;
    inset: -14% 0;
  }

  .philosophy-parallax img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .philosophy-body {
    max-width: 62rem;
    padding-block: clamp(5rem, 12vh, 8.5rem);
  }

  .philosophy-kicker {
    color: var(--terracotta);
    margin-bottom: 1.5rem;
  }

  .philosophy-text {
    font-size: clamp(1.55rem, 3vw, 2.6rem);
    line-height: 1.25;
    max-width: 30ch;
    margin-bottom: 2.25rem;
  }

  .philosophy-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--ink);
    transition: color 0.3s var(--ease-out), border-color 0.3s var(--ease-out);
  }

  .philosophy-link:hover {
    color: var(--terracotta);
    border-color: var(--terracotta);
  }
</style>
