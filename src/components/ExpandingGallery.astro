---
// Horizontal expanding-card deck: hovered photo widens, siblings compress.
// On touch screens it becomes a snap-scrolling strip.
const u = (id: string) =>
  `https://images.unsplash.com/${id}?auto=format&fit=crop&w=1100&q=80`;

const shots = [
  { image: u("photo-1519681393784-d120267933ba"), caption: "Night camp, 4,100 m" },
  { image: u("photo-1476514525535-07fb3b4ae5f1"), caption: "The morning crossing" },
  { image: u("photo-1509316785289-025f5b846b35"), caption: "Dust roads" },
  { image: u("photo-1526392060635-9d6019884377"), caption: "Above the clouds" },
  { image: u("photo-1533105079780-92b9be482077"), caption: "Blue hour, old port" },
];
---

<section class="gallery" aria-label="Moments from the field">
  <header class="gallery-head section-pad">
    <p class="label gallery-kicker reveal">Field notes</p>
    <p class="gallery-line serif reveal">Moments our travellers brought home.</p>
  </header>

  <div class="gallery-strip">
    {
      shots.map((shot) => (
        <figure class="gallery-item">
          <img src={shot.image} alt={shot.caption} loading="lazy" />
          <figcaption class="label">{shot.caption}</figcaption>
        </figure>
      ))
    }
  </div>
</section>

<style>
  .gallery {
    padding-block: clamp(4rem, 10vh, 8rem) clamp(5rem, 12vh, 9rem);
  }

  .gallery-kicker {
    color: var(--terracotta);
    margin-bottom: 1.2rem;
  }

  .gallery-line {
    font-size: clamp(1.55rem, 3vw, 2.4rem);
    margin-bottom: clamp(2.5rem, 6vh, 4rem);
  }

  .gallery-strip {
    display: flex;
    gap: 0.5rem;
    height: min(68vh, 32rem);
    padding-inline: var(--pad);
  }

  .gallery-item {
    position: relative;
    flex: 1;
    overflow: hidden;
    transition: flex 0.85s var(--ease-out);
  }

  .gallery-item:hover {
    flex: 2.8;
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.85s var(--ease-out);
  }

  .gallery-item:hover img {
    transform: scale(1.04);
  }

  .gallery-item figcaption {
    position: absolute;
    left: 1.1rem;
    bottom: 1rem;
    color: var(--cream);
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.45s var(--ease-out) 0.15s,
      transform 0.45s var(--ease-out) 0.15s;
    text-shadow: 0 1px 12px rgba(22, 20, 18, 0.55);
    white-space: nowrap;
  }

  .gallery-item:hover figcaption {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 760px), (pointer: coarse) {
    .gallery-strip {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      height: min(58vh, 26rem);
    }

    .gallery-item {
      flex: 0 0 74vw;
      scroll-snap-align: center;
    }

    .gallery-item figcaption {
      opacity: 1;
      transform: none;
    }
  }
</style>
