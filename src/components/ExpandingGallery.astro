---
// Horizontal expanding-card deck: hovered photo widens, siblings compress.
// On touch screens it becomes a snap-scrolling strip.
import { Image } from "astro:assets";
import { getTrips } from "../data/trips";
import { useT, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useT(locale);
const [palau, indonesia, honduras, philippines] = getTrips(locale);
const shots = [
  { photo: palau.stages[2].photo, caption: t("gallery.jellyfish") },
  { photo: indonesia.stages[0].photo, caption: t("gallery.orangutan") },
  { photo: honduras.stages[1].photo, caption: t("gallery.whaleshark") },
  { photo: philippines.stages[1].photo, caption: t("gallery.tarsier") },
  { photo: indonesia.stages[2].photo, caption: t("gallery.komodo") },
];
---

<section class="gallery" aria-label={t("gallery.aria")}>
  <header class="gallery-head section-pad">
    <p class="label gallery-kicker reveal">{t("gallery.kicker")}</p>
    <p class="gallery-line serif reveal">{t("gallery.line")}</p>
  </header>

  <div class="gallery-strip">
    {
      shots.map((shot) => (
        <figure class="gallery-item">
          <Image
            src={shot.photo.src}
            alt={shot.photo.alt}
            widths={[640, 1100]}
            sizes="(max-width: 760px) 74vw, 40vw"
          />
          <figcaption class="label">{shot.caption}</figcaption>
        </figure>
      ))
    }
  </div>
</section>

<style>
  .gallery {
    padding-block: clamp(4rem, 10vh, 8rem) clamp(5rem, 12vh, 9rem);
  }

  .gallery-kicker {
    color: var(--terracotta);
    margin-bottom: 1.2rem;
  }

  .gallery-line {
    font-size: clamp(1.55rem, 3vw, 2.4rem);
    margin-bottom: clamp(2.5rem, 6vh, 4rem);
  }

  .gallery-strip {
    display: flex;
    gap: 0.5rem;
    height: min(68vh, 32rem);
    padding-inline: var(--pad);
  }

  .gallery-item {
    position: relative;
    flex: 1;
    overflow: hidden;
    transition: flex 0.85s var(--ease-out);
  }

  .gallery-item:hover {
    flex: 2.8;
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.85s var(--ease-out);
  }

  .gallery-item:hover img {
    transform: scale(1.04);
  }

  .gallery-item figcaption {
    position: absolute;
    left: 1.1rem;
    bottom: 1rem;
    color: var(--cream);
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.45s var(--ease-out) 0.15s,
      transform 0.45s var(--ease-out) 0.15s;
    text-shadow: 0 1px 12px rgba(22, 20, 18, 0.55);
    white-space: nowrap;
  }

  .gallery-item:hover figcaption {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 760px), (pointer: coarse) {
    .gallery-strip {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      height: min(58vh, 26rem);
    }

    .gallery-item {
      flex: 0 0 74vw;
      scroll-snap-align: center;
    }

    .gallery-item figcaption {
      opacity: 1;
      transform: none;
    }
  }
</style>
