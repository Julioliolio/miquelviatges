---
import "../styles/global.css";
import { defaultLocale, locales, type Alternates, type Locale } from "../i18n/ui";

interface Props {
  title: string;
  description: string;
  locale: Locale;
  alternates: Alternates;
}

const { title, description, locale, alternates } = Astro.props;
const abs = (path: string) => new URL(path, Astro.site).href;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <script is:inline define:vars={{ locale, alternates, supported: locales }}>
      // Pick the visitor's language before anything renders. A choice made with the
      // nav switcher is remembered and always wins over the browser's preference.
      (() => {
        const KEY = "lang";
        const read = () => {
          try {
            return localStorage.getItem(KEY);
          } catch {
            return null;
          }
        };

        document.addEventListener("click", (e) => {
          const link = e.target instanceof Element && e.target.closest("[data-lang]");
          if (!link) return;
          try {
            localStorage.setItem(KEY, link.dataset.lang);
          } catch {}
        });

        let target = supported.includes(read()) ? read() : null;
        if (!target) {
          if (navigator.webdriver || /bot|crawl|spider|slurp/i.test(navigator.userAgent)) return;
          // Catalan, Galician and Basque speakers get the Spanish site.
          const families = { es: ["es", "ca", "gl", "eu"], en: ["en"] };
          for (const tag of navigator.languages || [navigator.language]) {
            const primary = String(tag).toLowerCase().split("-")[0];
            target = supported.find((l) => families[l]?.includes(primary)) || null;
            if (target) break;
          }
        }

        if (target && target !== locale && alternates[target]) {
          location.replace(alternates[target] + location.search + location.hash);
        }
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={abs(alternates[locale])} />
    {
      Object.entries(alternates).map(([lang, href]) => (
        <link rel="alternate" hreflang={lang} href={abs(href)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={abs(alternates[defaultLocale])} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}favicon.svg`} />
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}favicon.ico`} sizes="32x32" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Instrument+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
