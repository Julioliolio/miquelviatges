---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import credits from "../data/photo-credits.json";

const list = [...new Map(Object.values(credits).map((c) => [c.page, c])).values()];
---

<Layout title="Photo credits · Tramuntana" description="Credits and licences for the photographs used on this site.">
  <Nav />
  <main class="credits section-pad">
    <p class="label credits-kicker">Credits</p>
    <h1 class="credits-title serif">Photographs</h1>
    <p class="credits-intro">
      The wildlife and landscape photographs on this site come from Wikimedia Commons and are used
      under the licences listed below. Many thanks to their authors.
    </p>
    <ul class="credits-list">
      {
        list.map((c) => (
          <li>
            <a href={c.page} rel="noopener" target="_blank">{c.title.replace(/^File:/, "")}</a>
            <span>
              {c.artist && <>{c.artist} · </>}
              {c.license}
            </span>
          </li>
        ))
      }
    </ul>
  </main>
  <Footer />
</Layout>

<script>
  const nav = document.getElementById("site-nav");
  nav?.classList.add("scrolled");
</script>

<style>
  .credits {
    padding-block: 8rem 6rem;
    max-width: 60rem;
  }

  .credits-kicker {
    color: var(--terracotta);
    margin-bottom: 1.2rem;
  }

  .credits-title {
    font-size: clamp(2.6rem, 6vw, 5rem);
    margin-bottom: 1.5rem;
  }

  .credits-intro {
    color: var(--ink-soft);
    max-width: 56ch;
    margin-bottom: 3rem;
  }

  .credits-list {
    list-style: none;
    padding: 0;
  }

  .credits-list li {
    display: grid;
    gap: 0.15rem;
    padding-block: 0.9rem;
    border-top: 1px solid var(--line);
    font-size: 0.9375rem;
  }

  .credits-list a {
    text-decoration: underline;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }

  .credits-list span {
    color: var(--ink-soft);
    font-size: 0.8125rem;
  }
</style>
